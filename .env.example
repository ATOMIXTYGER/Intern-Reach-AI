# Database & Cache (PostgreSQL & Redis)
# SQLite fallback is used automatically locally if DATABASE_URL starts with sqlite
DATABASE_URL=postgresql+asyncpg://internreach_user:internreach_password@localhost:5432/internreach_db
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Claude as primary, Gemini optional secondary)
PRIMARY_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Web Search Provider (Tavily or SerpAPI)
SEARCH_PROVIDER=tavily
SEARCH_PROVIDER_API_KEY=your_search_api_key_here

# Security Tokens & Secrets (Argon2 / Bcrypt & JWT)
JWT_SECRET=super-secret-jwt-key-internreach-ai-change-in-production-32char
SESSION_SECRET=super-secret-session-key-change-in-production

# SMTP Email Notifications (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=notifications@internreach.ai

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Offline / Zero Cost Mock Mode (Set to true to run immediately without paid API keys)
MOCK_MODE=true
